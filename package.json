{
  "name": "tailwind-context-resolver-mcp",
  "version": "0.1.1",
  "description": "MCP server that resolves project-specific Tailwind CSS design tokens and validates utility classes against the local config",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tailwind-context-resolver-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "prepack": "chmod +x dist/index.js",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "prepare": "husky"
  },
  "keywords": [
    "tailwind",
    "css",
    "mcp",
    "design-tokens",
    "ai",
    "developer-tools"
  ],
  "author": "vola-trebla",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "**/*.{ts,mjs,json,md}": [
      "prettier --write"
    ],
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "mcpName": "io.github.vola-trebla/tailwind-context-resolver-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/vola-trebla/tailwind-context-resolver-mcp.git"
  }
}
